        <servlet-class>com.vtuconnect.controller.DownloadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadServlet</servlet-name>
        <url-pattern>/api/downloads</url-pattern>
        <url-pattern>/api/downloads/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GlobalSearchServlet</servlet-name>
        <servlet-class>com.vtuconnect.controller.GlobalSearchServlet</servlet-class>
    </servlet>
