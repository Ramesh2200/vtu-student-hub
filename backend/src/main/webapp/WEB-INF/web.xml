        <servlet-class>com.vtuconnect.controller.AdminAnnouncementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAnnouncementServlet</servlet-name>
        <url-pattern>/api/admin/announcements</url-pattern>
        <url-pattern>/api/admin/announcements/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.vtuconnect.controller.AdminUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
